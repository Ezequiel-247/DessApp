{
  "name": "desapp-backend",
  "version": "1.0.0",
  "description": "Backend for DesApp project",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "db:seed": "node src/seeders/seedDatabase.js",
    "db:up": "docker-compose up -d",
    "db:down": "docker-compose down",
    "db:prepare": "npm run db:down && npm run db:up && npm run db:seed",
    "test": "jest",
    "test:ci": "jest --runInBand",
    "test:coverage": "jest --coverage",
    "lint": "eslint src"
  },
  "keywords": [
    "nodejs",
    "express",
    "sequelize",
    "postgresql"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.0",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "js-yaml": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.10",
    "pg": "^8.11.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.35.0",
    "swagger-ui-express": "^5.0.1",
    "validator": "^13.11.0"
  },
  "devDependencies": {
    "eslint": "^8.54.0",
    "jest": "^30.3.0",
    "nodemon": "^3.0.1"
  }
}
