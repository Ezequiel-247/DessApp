# ==========================================
# CONFIGURACIÓN DEL FRONTEND (Vite / React)
# ==========================================

# Puerto donde correrá la aplicación web (por defecto 3000)
PORT=3000

# ==========================================
# NOTA DE ARQUITECTURA: CONEXIÓN DIRECTA
# ==========================================
# Ahora usamos una conexión directa (sin el proxy de Vite).
# El 'apiClient' lee esta variable para saber a dónde disparar.
#
# DESARROLLO: 
# Configurá VITE_API_URL con tu puerto del backend (ej: http://localhost:3001)
#
# PRODUCCIÓN:
# Configurá VITE_API_URL con la URL real de tu backend (ej: https://api.tu-app.com)
# ==========================================

VITE_API_URL=http://localhost:3001
