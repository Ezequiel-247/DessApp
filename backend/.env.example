# Environment
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=desapp_db
DB_USER=postgres
DB_PASSWORD=password
# En producción (Render/Supabase/Neon) poner en true: exigen SSL para conexiones externas.
DB_SSL=false

# Server
PORT=3001

# CORS (Seguridad: ¿Quién puede pedirle datos a esta API?)
# En desarrollo suele ser el puerto 3000 (React/Vite). 
# En producción debe ser el dominio oficial (ej: https://academiapro.com)
FRONTEND_URL=http://localhost:3000

# JWT
JWT_SECRET=your_super_secret_key_here
JWT_EXPIRES_IN=24h

# SMTP (emails de invitaciones y sesiones)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Cloudinary (almacenamiento de avatares e imagenes de posts)
# Si se deja vacio, se usa disco local (uploads/) como en desarrollo.
# En produccion (Render, etc.) completar estos 3 valores para que las imagenes
# no se pierdan en cada redeploy (el disco de Render es efimero).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
