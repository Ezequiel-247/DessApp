// DBML generado desde backend/src/models

Enum user_role_enum {
  admin
  student
}

Enum custom_plan_item_status_enum {
  planificado
  cursando
  completado
}

Enum study_session_type_enum {
  virtual
  presencial
}

Enum study_session_status_enum {
  abierta
  cancelada
  finalizada
}

Enum study_session_registration_status_enum {
  pending
  approved
  rejected
}

Table academic_records {
  id int [pk, increment]
  id_student int [not null]
  id_subject int
  plan_subject_id int
  course_id int
  year int
  semester int
  grade varchar
  status varchar [not null]
  regularity_expires_at date
  total_upvotes int [default: 0]
  likes_count int [default: 0]
  dislikes_count int [default: 0]
  valoracion_ratio float [default: null]
  createdAt timestamp [not null]
  updatedAt timestamp [not null]
}

Table activities {
  id int [pk, increment]
  name varchar [not null]
  code varchar
  description text
  createdAt timestamp [not null]
  updatedAt timestamp [not null]
}

Table activities_records {
  id int [pk, increment]
  id_student int [not null]
  id_activity int [not null]
  plan_credit_block_item_id int
  year int
  semester int
  grade varchar
  status varchar [not null]
  createdAt timestamp [not null]
  updatedAt timestamp [not null]
}

Table admins {
  id int [pk, increment]
  id_users int [not null]
  cuil varchar [not null]
  role varchar
  id_of_creator int
  createdAt timestamp [not null]
  updatedAt timestamp [not null]
}

Table careers {
  id int [pk, increment]
  name varchar [not null]
  id_institute int [not null]
  degree_title varchar [not null]
  duration int [not null]
  code varchar [not null]
  description varchar
  createdAt timestamp [not null]
  updatedAt timestamp [not null]
}

Table comments {
  id bigint [pk, increment]
  target_type varchar [not null]
  target_id bigint [not null]
  id_author int [not null]
  content text [not null]
  likes_count int [default: 0]
  dislikes_count int [default: 0]
  total_upvotes int [default: 0]
  valoracion_ratio decimal(10,4) [default: null]
  created_at timestamp
}

Table connections {
  id int [pk, increment]
  id_user int [not null]
  id_connected_user int [not null]
  status varchar
  invitation_token varchar [unique]
  target_email varchar
  createdAt timestamp [not null]
  updatedAt timestamp [not null]
}

Table correlativities {
  id int [pk, increment]
  id_plan_subject_target int [not null]
  id_required_plan_subject int [not null]
  type varchar
}

Table course_schedules {
  id int [pk, increment]
  course_id int [not null]
  day_of_week varchar [not null]
  start_time time [not null]
  end_time time [not null]
  classroom varchar
  createdAt timestamp [not null]
  updatedAt timestamp [not null]
}

Table courses {
  id int [pk, increment]
  plan_subject_id int [not null]
  commission varchar [not null]
  year int [not null]
  term int [not null]
  capacity int [not null, default: 50]
  professor_name varchar
  createdAt timestamp [not null]
  updatedAt timestamp [not null]
}

Table custom_study_plan_elective_choices {
  id int [pk, increment]
  id_custom_study_plan int [not null]
  id_elective_block int [not null]
  plan_subject_id int [not null]
  createdAt timestamp [not null]
  updatedAt timestamp [not null]

  Indexes {
    (id_custom_study_plan, plan_subject_id) [unique]
  }
}

Table custom_study_plan_items {
  id int [pk, increment]
  id_custom_study_plan int [not null]
  plan_subject_id int [not null]
  target_year int [not null]
  target_term int [not null]
  order int
  status custom_plan_item_status_enum [default: 'planificado']
  createdAt timestamp [not null]
  updatedAt timestamp [not null]
}

Table custom_study_plan_sabbaticals {
  id int [pk, increment]
  id_custom_study_plan int [not null]
  year int [not null]
  term int [not null]
  createdAt timestamp [not null]
  updatedAt timestamp [not null]

  Indexes {
    (id_custom_study_plan, year, term) [unique]
  }
}

Table custom_study_plan_unahur_choices {
  id int [pk, increment]
  id_custom_study_plan int [not null]
  id_unahur_block int [not null]
  plan_subject_id int [not null]
  createdAt timestamp [not null]
  updatedAt timestamp [not null]

  Indexes {
    (id_custom_study_plan, plan_subject_id) [unique]
  }
}

Table custom_study_plans {
  id int [pk, increment]
  id_student int [not null]
  name varchar [not null]
  weekly_hours int
  createdAt timestamp [not null]
  updatedAt timestamp [not null]
}

Table final_exams {
  id int [pk, increment]
  id_academic_record int [not null]
  grade varchar
  year int
  semester int
  status varchar [not null]
  attempt_number int [not null, default: 1]
  createdAt timestamp [not null]
  updatedAt timestamp [not null]
}

Table instance_subjects {
  id int [pk, increment]
  id_subject int [not null]
  comision int
  professor varchar
  schedule varchar
  classroom varchar
  is_exam boolean [default: false]
  regularity_expires_at timestamp
  term int
  createdAt timestamp [not null]
  updatedAt timestamp [not null]
}

Table institutes {
  id int [pk, increment]
  name varchar [not null, unique]
  short_name varchar [not null]
  responsible varchar [not null]
  status varchar [not null]
  email varchar [not null]
  tel varchar [not null]
  address varchar [not null]
  notes varchar
  createdAt timestamp [not null]
  updatedAt timestamp [not null]
}

Table materials {
  id bigint [pk, increment]
  id_author int [not null]
  id_subject int [not null]
  title varchar [not null]
  type varchar
  file_url varchar [not null]
  total_upvotes int [default: 0]
  likes_count int [default: 0]
  dislikes_count int [default: 0]
  valoracion_ratio float [default: null]
  status varchar [not null, default: 'active']
  tags text
  createdAt timestamp [not null]
  updatedAt timestamp [not null]
}

Table notifications {
  id int [pk, increment]
  id_user int [not null]
  type varchar [not null]
  title varchar [not null]
  message varchar [not null]
  read boolean [default: false]
  createdAt timestamp [not null]
  updatedAt timestamp [not null]
}

Table plan_credit_block_items {
  id int [pk, increment]
  id_credit_block int [not null]
  id_activity int [not null]
  credits int [not null]
  createdAt timestamp [not null]
  updatedAt timestamp [not null]

  Indexes {
    (id_credit_block, id_activity) [unique]
  }
}

Table plan_credit_blocks {
  id int [pk, increment]
  id_study_plan int [not null]
  name varchar [not null]
  min_credits_required int
  max_credits_allowed int
  sort_order int
  createdAt timestamp [not null]
  updatedAt timestamp [not null]

  Indexes {
    (id_study_plan, name) [unique]
  }
}

Table plan_elective_block_subjects {
  id int [pk, increment]
  id_elective_block int [not null]
  id_plan_subject int [not null]
  createdAt timestamp [not null]
  updatedAt timestamp [not null]

  Indexes {
    (id_elective_block, id_plan_subject) [unique]
  }
}

Table plan_elective_blocks {
  id int [pk, increment]
  id_study_plan int [not null]
  name varchar [not null]
  min_required int [not null, default: 1]
  requires_approved_mandatory_count int [not null, default: 0]
  suggested_year int
  sort_order int
  createdAt timestamp [not null]
  updatedAt timestamp [not null]
}

Table plan_subjects {
  id int [pk, increment]
  id_study_plan int [not null]
  id_subject int [not null]
  suggested_year int [not null]
  suggested_term int [not null]
  credits int
  is_elective boolean [not null, default: false]
  is_final_project boolean [not null, default: false]
  createdAt timestamp [not null]
  updatedAt timestamp [not null]

  Indexes {
    (id_study_plan, id_subject) [unique]
  }
}

Table plan_unahur_blocks {
  id int [pk, increment]
  id_study_plan int [not null]
  suggested_year int [not null]
  suggested_term int
  sort_order int
  createdAt timestamp [not null]
  updatedAt timestamp [not null]
}

Table posts {
  id bigint [pk, increment]
  id_author int [not null]
  title varchar [not null]
  content text [not null]
  created_at timestamp
  total_upvotes int [default: 0]
  likes_count int [default: 0]
  dislikes_count int [default: 0]
  valoracion_ratio float [default: null]
  images json [default: '[]']
}

Table report_reasons {
  id int [pk, increment]
  name varchar [not null]
  description varchar
  createdAt timestamp [not null]
  updatedAt timestamp [not null]
}

Table reports {
  id int [pk, increment]
  id_reporter int [not null]
  id_content int
  content_type varchar
  id_reason int
  status varchar
  resolved_by_id int
  createdAt timestamp [not null]
  updatedAt timestamp [not null]
}

Table sessions {
  id int [pk, increment]
  id_user int [not null]
  token varchar
  expires_at timestamp
  createdAt timestamp [not null]
  updatedAt timestamp [not null]
}

Table student_career_enrollments {
  id int [pk, increment]
  student_id int [not null]
  career_id int [not null]
  enrolled_at date [not null, default: `now()`]
  completed_at date
  status varchar [not null, default: 'active']
  is_active boolean [not null, default: true]
  study_plan_id int
  createdAt timestamp [not null]
  updatedAt timestamp [not null]
}

Table students {
  user_id int [pk]
  legajo varchar [unique]
  public_profile boolean [default: false]
  show_email boolean [not null, default: false]
  show_academic_info boolean [default: true]
  publish_approvals boolean [default: false]
}

Table study_plans {
  id int [pk, increment]
  id_career int [not null]
  name varchar [not null]
  status varchar [not null]
  years_duration int
  course_type varchar
  default_term int
  min_total_credits int
  createdAt timestamp [not null]
  updatedAt timestamp [not null]
}

Table study_session_registrations {
  id int [pk, increment]
  study_session_id int [not null]
  student_id int [not null]
  status study_session_registration_status_enum [not null, default: 'pending']
  createdAt timestamp [not null]
  updatedAt timestamp [not null]
}

Table study_sessions {
  id int [pk, increment]
  host_student_id int [not null]
  subject_id int [not null]
  title varchar [not null]
  description text
  type study_session_type_enum [not null]
  meeting_link varchar
  location varchar
  date_time timestamp [not null]
  duration_hours int [not null, default: 1]
  duration_minutes int [not null, default: 0]
  max_slots int
  approval_required boolean [not null, default: false]
  status study_session_status_enum [not null, default: 'abierta']
  reminder_sent boolean [not null, default: false]
  createdAt timestamp [not null]
  updatedAt timestamp [not null]
}

Table subjects {
  id int [pk, increment]
  name varchar [not null]
  code varchar [not null]
  is_unahur boolean [not null, default: false]
  weekly_hours int [not null]
  createdAt timestamp [not null]
  updatedAt timestamp [not null]
  deletedAt timestamp
}

Table system_configs {
  key varchar [pk, not null]
  value varchar
}

Table users {
  id int [pk, increment]
  name varchar
  lastname varchar
  email varchar [not null, unique]
  avatar varchar
  role user_role_enum [not null, default: 'student']
  is_active boolean [not null, default: true]
  password varchar [not null]
  createdAt timestamp [not null]
  updatedAt timestamp [not null]
}

Table votes {
  id int [pk, increment]
  target_type varchar [not null]
  target_id bigint [not null]
  id_student int [not null]
  is_upvote boolean [not null]
  createdAt timestamp [not null]
  updatedAt timestamp [not null]

  Indexes {
    (target_type, target_id, id_student) [unique]
  }
}

// Relaciones
Ref: academic_records.id < final_exams.id_academic_record
Ref: activities.id < activities_records.id_activity
Ref: activities.id < plan_credit_block_items.id_activity
Ref: admins.id < admins.id_of_creator
Ref: careers.id < student_career_enrollments.career_id
Ref: careers.id < study_plans.id_career
Ref: courses.id < academic_records.course_id
Ref: courses.id < course_schedules.course_id
Ref: custom_study_plans.id < custom_study_plan_elective_choices.id_custom_study_plan
Ref: custom_study_plans.id < custom_study_plan_items.id_custom_study_plan
Ref: custom_study_plans.id < custom_study_plan_sabbaticals.id_custom_study_plan
Ref: custom_study_plans.id < custom_study_plan_unahur_choices.id_custom_study_plan
Ref: institutes.id < careers.id_institute
Ref: plan_credit_block_items.id < activities_records.plan_credit_block_item_id
Ref: plan_credit_blocks.id < plan_credit_block_items.id_credit_block
Ref: plan_elective_blocks.id < custom_study_plan_elective_choices.id_elective_block
Ref: plan_elective_blocks.id < plan_elective_block_subjects.id_elective_block
Ref: plan_subjects.id < academic_records.plan_subject_id
Ref: plan_subjects.id < correlativities.id_plan_subject_target
Ref: plan_subjects.id < correlativities.id_required_plan_subject
Ref: plan_subjects.id < courses.plan_subject_id
Ref: plan_subjects.id < custom_study_plan_elective_choices.plan_subject_id
Ref: plan_subjects.id < custom_study_plan_items.plan_subject_id
Ref: plan_subjects.id < custom_study_plan_unahur_choices.plan_subject_id
Ref: plan_subjects.id < plan_elective_block_subjects.id_plan_subject
Ref: plan_unahur_blocks.id < custom_study_plan_unahur_choices.id_unahur_block
Ref: report_reasons.id < reports.id_reason
Ref: students.user_id < comments.id_author
Ref: students.user_id < custom_study_plans.id_student
Ref: students.user_id < materials.id_author
Ref: students.user_id < posts.id_author
Ref: students.user_id < student_career_enrollments.student_id
Ref: students.user_id < study_session_registrations.student_id
Ref: students.user_id < study_sessions.host_student_id
Ref: students.user_id < votes.id_student
Ref: study_plans.id < plan_credit_blocks.id_study_plan
Ref: study_plans.id < plan_elective_blocks.id_study_plan
Ref: study_plans.id < plan_subjects.id_study_plan
Ref: study_plans.id < plan_unahur_blocks.id_study_plan
Ref: study_plans.id < student_career_enrollments.study_plan_id
Ref: study_sessions.id < study_session_registrations.study_session_id
Ref: subjects.id < academic_records.id_subject
Ref: subjects.id < instance_subjects.id_subject
Ref: subjects.id < materials.id_subject
Ref: subjects.id < plan_subjects.id_subject
Ref: subjects.id < study_sessions.subject_id
Ref: users.id < academic_records.id_student
Ref: users.id < activities_records.id_student
Ref: users.id < admins.id_users
Ref: users.id < connections.id_connected_user
Ref: users.id < connections.id_user
Ref: users.id < notifications.id_user
Ref: users.id < reports.id_reporter
Ref: users.id < reports.resolved_by_id
Ref: users.id < sessions.id_user
Ref: users.id < students.user_id
